{
  "expo": {
    "name": "BillPe",
    "slug": "billpe-pos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/fa5394a7-4f7e-4a6b-b464-0f146f5be73f"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.billpe.pos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#020617"
      },
      "package": "com.billpe.pos",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BillPe to access your camera to scan product barcodes."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.333491210133-4ttarhv4f2squs5j9cjc2ahb9k482nrb"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fa5394a7-4f7e-4a6b-b464-0f146f5be73f"
      }
    },
    "owner": "application00"
  }
}